<Window x:Class="VupPlayer.App.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VupPlayer.App"
        Title="VUP 迷你播放器" Width="380" Height="112"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <local:PlayPauseGlyphConverter x:Key="PlayGlyph" />
        <local:PlayModeGlyphConverter x:Key="ModeGlyph" />
        <local:StreamModeConverter x:Key="StreamConv" />
        <local:CoverConverter x:Key="Cover" />
        <local:SafeMaxConverter x:Key="SafeMax" />
        <local:TimeConverter x:Key="Time" />
        <local:BoolToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="MiniIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="CornerIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
        </Style>
    </Window.Resources>

    <!-- 外边距留给阴影 -->
    <Border x:Name="Root" Margin="8" CornerRadius="12" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseWheel="Root_MouseWheel">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 封面：双击回到主界面 -->
            <Border Width="62" Height="62" Margin="10,10,0,4" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                    ClipToBounds="True" Cursor="Hand" ToolTip="双击回到主界面" MouseLeftButtonDown="Cover_MouseLeftButtonDown">
                <Grid>
                    <Image Stretch="UniformToFill" Source="{Binding Player.Current.CoverUrl, Converter={StaticResource Cover}, ConverterParameter=160}" />
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource HoverBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Player.Current, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                </Grid>
            </Border>

            <!-- 标题与状态 -->
            <StackPanel Grid.Column="1" Margin="12,12,6,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Player.Current.DisplayTitle, FallbackValue='未在播放'}" FontSize="13.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Player.Current.VideoTitle}" />
                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Player.Current.StreamerName, Mode=OneWay, FallbackValue=''}" />
                    <Run Text="{Binding Player.Current.UpName, Mode=OneWay, StringFormat='  ·  {0}', FallbackValue=''}" />
                </TextBlock>
                <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                            <Setter Property="Text" Value="{Binding Player.PlayMode, Converter={StaticResource ModeGlyph}, ConverterParameter=text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.IsBuffering}" Value="True">
                                    <Setter Property="Text" Value="缓冲中…" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Player.IsLoading}" Value="True">
                                    <Setter Property="Text" Value="正在加载…" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 右侧：角落按钮 + 播放控制 -->
            <Grid Grid.Column="2" Margin="0,4,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CornerIcon}" Content="&#xE740;" ToolTip="回到主界面（Esc）" Click="Expand_Click" />
                    <Button Style="{StaticResource CornerIcon}" Content="&#xE711;" ToolTip="隐藏到托盘" Click="Hide_Click" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Button Style="{StaticResource MiniIcon}" Content="{Binding Player.PlayMode, Converter={StaticResource ModeGlyph}}"
                            ToolTip="{Binding Player.PlayMode, Converter={StaticResource ModeGlyph}, ConverterParameter=text}" Click="Mode_Click" />
                    <Button Style="{StaticResource MiniIcon}" Content="&#xE892;" ToolTip="上一首" Click="Prev_Click" />
                    <Button Style="{StaticResource PlayButton}" Width="36" Height="36" FontSize="14" Margin="2,0"
                            Content="{Binding Player.IsPlaying, Converter={StaticResource PlayGlyph}}" ToolTip="播放 / 暂停（空格）" Click="Play_Click" />
                    <Button Style="{StaticResource MiniIcon}" Content="&#xE893;" ToolTip="下一首" Click="Next_Click" />
                </StackPanel>
            </Grid>

            <!-- 进度 -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Player.Position, Converter={StaticResource Time}}" Foreground="{StaticResource SubTextBrush}" FontSize="10" VerticalAlignment="Center" />
                <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Margin="8,0" Minimum="0"
                        Maximum="{Binding Player.Duration, Converter={StaticResource SafeMax}}"
                        Visibility="{Binding Player.IsWatchingLive, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                        PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp" />
                <TextBlock Grid.Column="2" Text="{Binding Player.Duration, Converter={StaticResource Time}}" Foreground="{StaticResource SubTextBrush}" FontSize="10" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
