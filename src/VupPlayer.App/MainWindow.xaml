<Window x:Class="VupPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VupPlayer.App"
        xmlns:controls="clr-namespace:VupPlayer.App.Controls"
        xmlns:vm="clr-namespace:VupPlayer.App.ViewModels"
        Title="VUP 切片播放器" Width="1280" Height="780" MinWidth="980" MinHeight="600"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:TimeConverter x:Key="Time" />
        <local:PlayPauseGlyphConverter x:Key="PlayGlyph" />
        <local:PlayModeGlyphConverter x:Key="ModeGlyph" />
        <local:StreamModeConverter x:Key="StreamConv" />
        <local:FavoriteGlyphConverter x:Key="FavGlyph" />
        <local:CoverConverter x:Key="Cover" />
        <local:SafeMaxConverter x:Key="SafeMax" />

        <CollectionViewSource x:Key="NavView" Source="{Binding NavItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomRow" Height="88" />
        </Grid.RowDefinitions>

        <!-- ============ 挂件模式标题栏（拖动这里移动窗口） ============ -->
        <Grid x:Name="WidgetTitleBar" Grid.Row="0" Background="{StaticResource PanelBrush}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="VUP 挂件" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="11" Content="&#xE73F;" ToolTip="迷你条（Ctrl+M）"
                        Click="Mini_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="11" Content="&#xE740;" ToolTip="回到完整界面（Esc）"
                        Click="WidgetExit_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="11" Content="&#xE711;" ToolTip="隐藏到托盘"
                        Click="WidgetHide_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <!-- ============ 顶栏 ============ -->
        <Grid x:Name="TopBar" Grid.Row="0" Background="{StaticResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" FontSize="20" VerticalAlignment="Center" />
                <TextBlock Text="VUP 切片播放器" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Column="1" Margin="0,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="620" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ImportBox" Style="{StaticResource DarkTextBox}" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="粘贴 BV 号 / 视频链接 / 收藏夹 / 合集 / UP 主空间，回车导入" KeyDown="ImportBox_KeyDown" />
                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ImportCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                            <Setter Property="Content" Value="导入" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                    <Setter Property="Content" Value="取消" />
                                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding ImportStatus}" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ImportStatus}" />
            </Grid>
            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="Account_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="Text" Value="{Binding UserName}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                        <Setter Property="Text" Value="扫码登录 B 站" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;" Margin="0,0,12,0" ToolTip="设置" Click="Settings_Click" />
        </Grid>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="210" />
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 导航 -->
            <Border x:Name="NavPanel" Background="{StaticResource PanelBrush}">
                <ListBox x:Name="NavList" ItemsSource="{Binding Source={StaticResource NavView}}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,4,0,12"
                         ContextMenuOpening="NavList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" />
                                    </DockPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Width="22" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource SubTextBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 曲目列表 -->
            <Grid x:Name="ListPanel" Grid.Column="1" Margin="18,14,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ListTitle}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ListSubtitle}" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBox Style="{StaticResource DarkTextBox}" Width="200" Tag="搜索歌名、主播、UP 主、标签"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                        <Button Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding PlayAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="播放全部" Foreground="White" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Margin="8,0,0,0" Command="{Binding ShuffleAllCommand}" ToolTip="洗牌播放">
                            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ListView x:Name="TrackList" Grid.Row="1" ItemsSource="{Binding Tracks}" Background="Transparent" BorderThickness="0"
                          ItemContainerStyle="{StaticResource TrackRowStyle}" SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="TrackList_MouseDoubleClick" ContextMenuOpening="TrackList_ContextMenuOpening"
                          KeyDown="TrackList_KeyDown" SizeChanged="TrackList_SizeChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ContextMenu>
                        <ContextMenu />
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Favorite, Converter={StaticResource FavGlyph}}" FontFamily="{StaticResource IconFont}"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="4,0,0,0" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="TitleColumn" Header="标题" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontSize="13.5" ToolTip="{Binding VideoTitle}" />
                                            <TextBlock Text="{Binding VideoTitle}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                                       Visibility="{Binding SongTitle, Converter={StaticResource BoolVis}}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="主播" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StreamerName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubTextBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="切片 man" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UpName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubTextBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="标签" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tags}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="时长" Width="56">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="播放" Width="46">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlayCount}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 空状态 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding Tracks.Count, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="{StaticResource HoverBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="这里还没有曲目" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="在上方粘贴 BV 号或收藏夹链接导入；登录后可以直接导入自己的收藏夹" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 右侧：画面 / 封面 + 正在播放 + 接下来。挂件模式下它占满整个窗口 -->
            <Border x:Name="RightPanel" Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Margin="0,12,12,10"
                    MouseWheel="RightPanel_MouseWheel">
                <Grid x:Name="RightGrid" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="MediaArea" Height="198" CornerRadius="8" Background="Black" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="CoverImage" Stretch="UniformToFill"
                                   Source="{Binding Player.Current.CoverUrl, Converter={StaticResource Cover}, ConverterParameter=480}" />
                            <controls:MpvHost x:Name="VideoHost" />
                            <TextBlock x:Name="NoTrackHint" Text="选择一首切片开始播放" Foreground="{StaticResource SubTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="NowPlayingInfo" Grid.Row="1" Margin="2,12,2,0" Visibility="{Binding Player.Current, Converter={StaticResource BoolVis}}">
                        <TextBlock x:Name="NowTitle" Text="{Binding Player.Current.DisplayTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Player.Current.VideoTitle}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Player.Current.StreamerName, Mode=OneWay, FallbackValue=''}" />
                            <Run Text="  ·  切片 " />
                            <Run Text="{Binding Player.Current.UpName, Mode=OneWay, FallbackValue=''}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Player.RecommendReason}"
                                   Visibility="{Binding Player.RecommendReason, Converter={StaticResource BoolVis}}">
                            <Run Text="&#xE945;" FontFamily="{StaticResource IconFont}" /><Run Text=" " /><Run Text="{Binding Player.RecommendReason, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel x:Name="NowPlayingExtra">
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SubTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Player.Current.VideoTitle}" Visibility="{Binding Player.Current.SongTitle, Converter={StaticResource BoolVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Player.QualityText}" Foreground="{StaticResource SubTextBrush}" FontSize="11" />
                                <TextBlock Text="  缓冲中…" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                           Visibility="{Binding Player.IsBuffering, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Player.StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Player.StatusText, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <!-- 挂件模式：紧凑控制条 -->
                    <StackPanel x:Name="WidgetControls" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Player.Position, Converter={StaticResource Time}}" Foreground="{StaticResource SubTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            <Slider x:Name="WidgetProgress" Grid.Column="1" Style="{StaticResource ThinSlider}" Margin="8,0" Minimum="0"
                                    Maximum="{Binding Player.Duration, Converter={StaticResource SafeMax}}"
                                    PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp" />
                            <TextBlock Grid.Column="2" Text="{Binding Player.Duration, Converter={StaticResource Time}}" Foreground="{StaticResource SubTextBrush}" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13"
                                        Content="{Binding Player.PlayMode, Converter={StaticResource ModeGlyph}}"
                                        ToolTip="{Binding Player.PlayMode, Converter={StaticResource ModeGlyph}, ConverterParameter=text}" Click="Mode_Click" />
                                <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13"
                                        Content="{Binding Player.StreamMode, Converter={StaticResource StreamConv}, ConverterParameter=glyph}"
                                        ToolTip="切换画面 / 纯音频（V）" Click="Stream_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#xE892;" ToolTip="上一首" Click="Prev_Click" />
                                <Button Style="{StaticResource PlayButton}" Width="38" Height="38" FontSize="15" Margin="8,0"
                                        Content="{Binding Player.IsPlaying, Converter={StaticResource PlayGlyph}}" ToolTip="播放 / 暂停（空格）" Click="Play_Click" />
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#xE893;" ToolTip="下一首" Click="Next_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                <Slider Style="{StaticResource ThinSlider}" Width="56" Margin="6,0,2,0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        Value="{Binding Player.Volume}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 列表标题；挂件模式下换成小搜索框 -->
                    <TextBlock x:Name="UpcomingHeader" Grid.Row="3" Text="{Binding UpcomingTitle}" Style="{StaticResource SectionHeader}" Margin="2,16,0,6" />
                    <TextBox x:Name="WidgetSearchBox" Grid.Row="3" Style="{StaticResource DarkTextBox}" Height="28" FontSize="12" Margin="0,8,0,6"
                             Padding="8,3" Tag="搜索曲库（空着时显示播放队列）" Visibility="Collapsed"
                             Text="{Binding WidgetSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" KeyDown="WidgetSearch_KeyDown" />

                    <ListBox x:Name="UpcomingList" Grid.Row="4" ItemsSource="{Binding Upcoming}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="Upcoming_MouseDoubleClick" Margin="-6,0,-6,0"
                             Visibility="{Binding WidgetSearch, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding StreamerName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 挂件模式的搜索结果 -->
                    <ListBox x:Name="WidgetResultList" Grid.Row="4" ItemsSource="{Binding WidgetResults}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="WidgetResult_MouseDoubleClick" Margin="-6,0,-6,0" KeyDown="WidgetResult_KeyDown"
                             Visibility="{Binding WidgetSearch, Converter={StaticResource BoolVis}}" ContextMenuOpening="WidgetResult_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                    <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding StreamerName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding UpName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="4" Text="没有找到匹配的曲目" Foreground="{StaticResource SubTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,0"
                               IsHitTestVisible="False" Visibility="{Binding WidgetNoResults, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 播放条 ============ -->
        <Grid x:Name="PlayerBar" Grid.Row="2" Background="{StaticResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- 左：当前曲目 -->
            <DockPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="6" Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                    <Image Stretch="UniformToFill" Source="{Binding Player.Current.CoverUrl, Converter={StaticResource Cover}, ConverterParameter=120}" />
                </Border>
                <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Player.Current.DisplayTitle, FallbackValue='未在播放'}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                    <TextBlock Text="{Binding Player.Current.StreamerName}" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- 中：控制 + 进度 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="640">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="{Binding Player.PlayMode, Converter={StaticResource ModeGlyph}, ConverterParameter=text}"
                            Content="{Binding Player.PlayMode, Converter={StaticResource ModeGlyph}}" Click="Mode_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Margin="10,0,0,0" ToolTip="上一首" Click="Prev_Click" />
                    <Button Style="{StaticResource PlayButton}" Content="{Binding Player.IsPlaying, Converter={StaticResource PlayGlyph}}" Margin="12,0" Click="Play_Click" ToolTip="播放 / 暂停（空格）" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="下一首" Click="Next_Click" />
                    <Button Style="{StaticResource IconButton}" Margin="10,0,0,0" Click="Stream_Click"
                            Content="{Binding Player.StreamMode, Converter={StaticResource StreamConv}, ConverterParameter=glyph}"
                            ToolTip="切换画面 / 纯音频（V）" />
                </StackPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Player.Position, Converter={StaticResource Time}}" Foreground="{StaticResource SubTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Margin="10,0" Minimum="0"
                            Maximum="{Binding Player.Duration, Converter={StaticResource SafeMax}}"
                            PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp" />
                    <TextBlock Grid.Column="2" Text="{Binding Player.Duration, Converter={StaticResource Time}}" Foreground="{StaticResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- 右：模式、音量 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="{Binding Player.PlayMode, Converter={StaticResource ModeGlyph}, ConverterParameter=text}" Foreground="{StaticResource SubTextBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Player.StreamMode, Converter={StaticResource StreamConv}, ConverterParameter=text}" Foreground="{StaticResource SubTextBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ToggleButton IsChecked="{Binding Player.Normalize}" ToolTip="音量均衡：减小不同切片之间的音量差" Cursor="Hand" Margin="0,0,10,0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" CornerRadius="6" Padding="8,4" Background="{StaticResource SurfaceBrush}">
                                <TextBlock x:Name="tx" Text="均衡" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter TargetName="tx" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                <Slider Style="{StaticResource ThinSlider}" Width="110" Margin="8,0,0,0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                        Value="{Binding Player.Volume}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8A1;" Margin="10,0,0,0" FontSize="14"
                        ToolTip="挂件模式：画面 + 列表 + 搜索的置顶小窗（Ctrl+G）" Click="Widget_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE73F;" FontSize="14"
                        ToolTip="迷你条（Ctrl+M）" Click="Mini_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
